generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String?  @map("password_hash")
  username         String?  @unique
  avatarUrl        String?  @map("avatar_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  role             String   @default("member")
  subscriptionTier String   @default("free") @map("subscription_tier")
  referredById     String?  @map("referred_by_id")

  // Relations
  partner       Partner?        @relation("PartnerReferrals", fields: [referredById], references: [id])
  preferences   UserPreference?
  goals         UserGoal?
  entries       JournalEntry[]
  circles       Circle[]        @relation("CreatedCircles")
  joinedCircles CircleMember[]
  emailLogs     EmailLog[]

  @@map("users")
}

model UserPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  beliefType           String?  @map("belief_type")
  themes               String[]
  isOnboarded          Boolean  @default(false) @map("is_onboarded")
  biometricsEnabled    Boolean  @default(false) @map("biometrics_enabled")
  securityPin          String?  @map("security_pin")
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  notificationTime     String   @default("07:30") @map("notification_time")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserGoal {
  id               String  @id @default(uuid())
  userId           String  @unique @map("user_id")
  dailyReflection  Boolean @default(true) @map("daily_reflection")
  morningDevotion  Boolean @default(true) @map("morning_devotion")
  eveningGratitude Boolean @default(false) @map("evening_gratitude")
  weeklyCommunity  Boolean @default(true) @map("weekly_community")
  spirituality     String?
  spouse           String?
  career           String?
  business         String?
  health           String?
  family           String?
  children         String?
  friends          String?
  finances         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_goals")
}

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  content   String
  mood      String?
  tags      String[]
  isPrivate Boolean  @default(true) @map("is_private")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("journal_entries")
}

model Circle {
  id          String   @id @default(uuid())
  name        String
  description String?
  creatorId   String   @map("creator_id")
  isPrivate   Boolean  @default(false) @map("is_private")
  createdAt   DateTime @default(now()) @map("created_at")

  creator User           @relation("CreatedCircles", fields: [creatorId], references: [id])
  members CircleMember[]

  @@map("circles")
}

model CircleMember {
  id       String   @id @default(uuid())
  circleId String   @map("circle_id")
  userId   String   @map("user_id")
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@map("circle_members")
}

model SignedContract {
  id               String    @id @default(uuid())
  referenceCode    String    @unique @map("reference_code")
  contractType     String    @default("influencer_partnership") @map("contract_type")
  fullName         String    @map("full_name")
  email            String
  idNumber         String?   @map("id_number")
  signatureData    String    @map("signature_data")
  commencementDate DateTime  @map("commencement_date") @db.Date
  contractVersion  String    @default("1.0") @map("contract_version")
  agreedToTerms    Boolean   @default(false) @map("agreed_to_terms")
  signedAt         DateTime  @default(now()) @map("signed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  emailSent        Boolean   @default(false) @map("email_sent")
  emailSentAt      DateTime? @map("email_sent_at")

  @@map("signed_contracts")
}

model EmailLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  emailType String   @map("email_type")
  sentAt    DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_logs")
}

model Partner {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id") // The True North user account for the partner
  promoCode      String   @unique @map("promo_code")
  referralLink   String   @unique @map("referral_link")
  commissionRate Float    @default(0.10) @map("commission_rate")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  referrals User[]          @relation("PartnerReferrals")
  clicks    ReferralVisit[]

  @@map("partners")
}

model ReferralVisit {
  id          String   @id @default(uuid())
  partnerId   String   @map("partner_id")
  source      String?  // e.g., 'instagram', 'tiktok', 'podcast'
  ipHash      String?  @map("ip_hash") // Privacy-friendly impressions tracking
  createdAt   DateTime @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("referral_visits")
}

model BetaTester {
  id        String   @id @default(uuid())
  email     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("beta_testers")
}

model BetaFeedback {
  id        String   @id @default(uuid())
  email     String?
  theme     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("beta_feedback")
}
