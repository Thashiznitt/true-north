{
  "expo": {
    "name": "True North",
    "slug": "true-north",
    "version": "1.0.0",
    "scheme": "truenorth",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121111"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thashiznitt.truenorth",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.thashiznitt.truenorth",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow True North to use your location to find nearby sanctuaries."
        }
      ],
      "expo-notifications",
      "expo-local-authentication",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "1e1f7d3a-e167-4889-a2e3-85f3dab1021a"
      }
    },
    "owner": "thashiznitt"
  }
}
