{
  "expo": {
    "name": "True North",
    "slug": "true-north",
    "version": "1.0.0",
    "scheme": "truenorth",
    "orientation": "portrait",
    "icon": "./assets/white-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/white-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C8A95A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thashiznitt.truenorth",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "NSFaceIDUsageDescription": "Allow True North to use Face ID for secure access to your sanctuary.",
        "NSPhotoLibraryUsageDescription": "Allow True North to access your photos to set your profile picture.",
        "NSCameraUsageDescription": "Allow True North to access your camera to take a profile picture.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.862052704275-64h0rdf93c0futbap8h4r70klf0ql233"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.thashiznitt.truenorth",
      "adaptiveIcon": {
        "foregroundImage": "./assets/white-icon.png",
        "backgroundColor": "#C8A95A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow True North to use your location to find nearby sanctuaries."
        }
      ],
      "expo-notifications",
      "expo-local-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosClientId": "862052704275-64h0rdf93c0futbap8h4r70klf0ql233.apps.googleusercontent.com",
          "iosUrlScheme": "com.googleusercontent.apps.862052704275-64h0rdf93c0futbap8h4r70klf0ql233"
        }
      ],
      "expo-apple-authentication",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "1e1f7d3a-e167-4889-a2e3-85f3dab1021a"
      }
    },
    "owner": "thashiznitt"
  }
}